#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
qmd-lite —— 知识库本地检索（qmd 的等价降级实现，纯 Python 标准库）

官方 qmd 基于 Bun 运行时（bun install -g https://github.com/tobi/qmd）。
本机未安装时，用本脚本承担同样的职责，**接口保持一致**：

    qmd-lite add wiki/                      建索引
    qmd-lite status                         索引状态
    qmd-lite query "问题" --json             检索 top5
    qmd-lite multi-get "wiki/concepts/*.md" -l 40    批量读取

与官方 qmd 的差异：
  - 只做 BM25 关键词检索，没有向量语义检索与 LLM 重排
  - 索引落在 .qmd-lite/index.json，不依赖外部数据库

中文分词：不引入 jieba 等外部依赖，对 CJK 采用「单字 + 相邻双字（bigram）」切分，
对 ASCII 采用单词切分。中文查询与文档走同一套切分，保证可比。
"""

from __future__ import annotations

import argparse
import glob as _glob
import hashlib
import json
import math
import os
import re
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INDEX_DIR = os.path.join(ROOT, ".qmd-lite")
INDEX_PATH = os.path.join(INDEX_DIR, "index.json")

SYSTEM_STEMS = {"index", "log", "overview", "questions"}
SYSTEM_TYPES = {"system-index", "system-log", "system-overview", "system-questions"}

K1 = 1.5
B = 0.75

CJK_RE = re.compile(r"[一-鿿]+")
ASCII_RE = re.compile(r"[a-z0-9]+(?:[-_][a-z0-9]+)*")
FRONTMATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*(?:\n|\Z)", re.DOTALL)


# --------------------------------------------------------------------------
# 分词
# --------------------------------------------------------------------------

def tokenize(text: str) -> list[str]:
    text = text.lower()
    tokens: list[str] = []

    for m in ASCII_RE.finditer(text):
        tok = m.group(0)
        tokens.append(tok)
        # 连字符 slug 额外拆成词元，让 "value-investing" 能被 "investing" 命中
        if "-" in tok or "_" in tok:
            tokens.extend(re.split(r"[-_]", tok))

    for run in CJK_RE.findall(text):
        tokens.extend(run)                       # 单字：保证短查询有召回
        for i in range(len(run) - 1):
            tokens.append(run[i:i + 2])          # 双字：保证词序信息

    return tokens


# --------------------------------------------------------------------------
# 页面读取
# --------------------------------------------------------------------------

def parse_frontmatter(text: str) -> dict:
    m = FRONTMATTER_RE.match(text)
    if not m:
        return {}
    fm: dict = {}
    list_key = None
    for line in m.group(1).splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        s = line.strip()
        if s.startswith("- ") and list_key:
            fm.setdefault(list_key, []).append(s[2:].strip().strip('"').strip("'"))
            continue
        if ":" not in s:
            continue
        k, _, v = s.partition(":")
        k, v = k.strip(), v.strip()
        if not v:
            list_key = k
            fm.setdefault(k, [])
            continue
        list_key = None
        if v.startswith("[") and v.endswith("]"):
            inner = v[1:-1].strip()
            fm[k] = [x.strip().strip('"').strip("'") for x in inner.split(",") if x.strip()]
        else:
            fm[k] = v.strip('"').strip("'")
    return fm


def is_indexable(path: str, text: str) -> tuple[bool, str]:
    """内容页才建索引：排除模板、系统页、outputs/ 报告、redirect 文件。"""
    rel = os.path.relpath(path, ROOT)
    parts = rel.split(os.sep)
    if "templates" in parts:
        return False, "模板"
    if len(parts) > 1 and parts[1] == "outputs":
        return False, "输出报告"

    fm = parse_frontmatter(text)
    if str(fm.get("graph-excluded", "")).lower() == "true":
        return False, "graph-excluded"
    if str(fm.get("type", "")) in SYSTEM_TYPES:
        return False, "系统页"
    stem = os.path.splitext(os.path.basename(path))[0]
    if stem in SYSTEM_STEMS:
        return False, "系统页"

    body = text[FRONTMATTER_RE.match(text).end():] if FRONTMATTER_RE.match(text) else text
    if re.search(r"^\s*redirect\s*[:：]", body, re.MULTILINE):
        return False, "redirect"
    return True, ""


def discover(target: str) -> list[str]:
    """target 可以是目录或 glob 模式。"""
    abspath = target if os.path.isabs(target) else os.path.join(ROOT, target)
    if os.path.isdir(abspath):
        found = []
        for dirpath, dirnames, filenames in os.walk(abspath):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            found.extend(os.path.join(dirpath, f) for f in filenames if f.endswith(".md"))
        return sorted(found)
    return sorted(p for p in _glob.glob(abspath, recursive=True) if p.endswith(".md"))


# --------------------------------------------------------------------------
# 建索引
# --------------------------------------------------------------------------

def load_index() -> dict:
    if not os.path.exists(INDEX_PATH):
        return {"docs": {}, "built_at": None}
    with open(INDEX_PATH, encoding="utf-8") as fh:
        return json.load(fh)


def cmd_add(args) -> int:
    targets = args.paths or ["wiki/"]
    files: list[str] = []
    for t in targets:
        files.extend(discover(t))

    docs: dict = {}
    skipped: dict[str, int] = {}
    now = time.time()

    for path in files:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
        ok, reason = is_indexable(path, text)
        if not ok:
            skipped[reason] = skipped.get(reason, 0) + 1
            continue

        fm = parse_frontmatter(text)
        m = FRONTMATTER_RE.match(text)
        body = text[m.end():] if m else text

        # title 加权：标题词在检索中更重要，这里把 title 重复注入词流
        title = str(fm.get("title", "")).strip() or os.path.splitext(os.path.basename(path))[0]
        aliases = fm.get("aliases", [])
        if isinstance(aliases, str):
            aliases = [aliases]
        boost = " ".join([title] + [str(a) for a in aliases]) * 3

        tokens = tokenize(body + " " + boost + " " + os.path.basename(path))
        tf: dict[str, int] = {}
        for t in tokens:
            tf[t] = tf.get(t, 0) + 1

        rel = os.path.relpath(path, ROOT)
        docs[rel] = {
            "path": rel,
            "title": title,
            "type": str(fm.get("type", "")),
            "aliases": [str(a) for a in aliases],
            "sha256": hashlib.sha256(text.encode("utf-8")).hexdigest(),
            "mtime": os.path.getmtime(path),
            "length": len(tokens),
            "tf": tf,
            "preview": re.sub(r"\s+", " ", body).strip()[:280],
        }

    # 把上次索引里已不在本次 target 范围、但文件仍存在的文档保留下来
    if not args.prune:
        old = load_index().get("docs", {})
        for rel, doc in old.items():
            if rel in docs:
                continue
            abspath = os.path.join(ROOT, rel)
            if os.path.exists(abspath):
                docs[rel] = doc

    os.makedirs(INDEX_DIR, exist_ok=True)
    payload = {"docs": docs, "built_at": now, "root": ROOT}
    with open(INDEX_PATH, "w", encoding="utf-8") as fh:
        json.dump(payload, fh, ensure_ascii=False)

    # 同时落一份人类可读摘要，便于 git diff 观察
    with open(os.path.join(INDEX_DIR, "status.json"), "w", encoding="utf-8") as fh:
        json.dump({
            "built_at": now,
            "doc_count": len(docs),
            "skipped": skipped,
            "docs": sorted(docs.keys()),
        }, fh, ensure_ascii=False, indent=2)

    print(f"已索引 {len(docs)} 个文档 → {os.path.relpath(INDEX_PATH, ROOT)}")
    if skipped:
        detail = "、".join(f"{k} {v}" for k, v in sorted(skipped.items()))
        print(f"已跳过 {sum(skipped.values())} 个非内容页面（{detail}）")
    return 0


# --------------------------------------------------------------------------
# 检索
# --------------------------------------------------------------------------

CJK_CHAR_RE = re.compile(r"^[一-鿿]$")
WEAK_WEIGHT = 0.25          # CJK 单字词元的权重


def term_weight(term: str) -> float:
    """CJK 单字即使命中也不代表语义相关。

    没有这层权重时，查询「量子色动力学胶子禁闭」会因为共享「力/机/制」等常用字，
    以 1.0 的归一化得分命中「注意力机制」——纯粹的字符噪声。
    因此把单字降权，并在打分时要求至少命中一个强词元（多字词 / ASCII 词）。
    """
    return WEAK_WEIGHT if CJK_CHAR_RE.match(term) else 1.0


def bm25_search(index: dict, query: str, top_k: int = 5, min_score: float = 0.05) -> list[dict]:
    docs = index.get("docs", {})
    if not docs:
        return []

    n = len(docs)
    avgdl = sum(d["length"] for d in docs.values()) / n if n else 1

    df: dict[str, int] = {}
    for d in docs.values():
        for term in d["tf"]:
            df[term] = df.get(term, 0) + 1

    q_terms = tokenize(query)
    # 查询里是否存在强词元。若全是单字（如查询"力"），则不强求强命中。
    query_has_strong = any(term_weight(t) >= 1.0 for t in q_terms)

    scored = []
    for d in docs.values():
        score = 0.0
        strong_score = 0.0
        dl = d["length"] or 1
        for term in q_terms:
            f = d["tf"].get(term, 0)
            if not f:
                continue
            idf = math.log(1 + (n - df.get(term, 0) + 0.5) / (df.get(term, 0) + 0.5))
            contribution = idf * (f * (K1 + 1)) / (f + K1 * (1 - B + B * dl / avgdl))
            weight = term_weight(term)
            score += weight * contribution
            if weight >= 1.0:
                strong_score += contribution

        if score <= 0:
            continue
        if query_has_strong and strong_score <= 0:
            continue        # 只靠单字蹭上的分数，不是真的命中
        scored.append((score, d))

    scored.sort(key=lambda x: -x[0])
    max_score = scored[0][0] if scored else 1.0
    results = [{**d, "score": round(s / max_score, 4)} for s, d in scored]
    # QUERY 流程要求"完整读取 top 5"，混入得分极低的页面会白白消耗上下文。
    # 按 top 得分的相对比例截断（默认 5%），可用 --min-score 调整。
    if min_score > 0:
        results = [r for r in results if r["score"] >= min_score]
    return results[:top_k]


def cmd_query(args) -> int:
    index = load_index()
    if not index.get("docs"):
        msg = "索引为空，请先执行：python3 scripts/qmd-lite add wiki/"
        if args.json:
            print(json.dumps({"error": msg, "results": []}, ensure_ascii=False, indent=2))
        else:
            print(msg, file=sys.stderr)
        return 1

    results = bm25_search(index, args.query, args.top_k, args.min_score)

    if args.json:
        print(json.dumps({
            "query": args.query,
            "count": len(results),
            "results": [{
                "path": r["path"],
                "title": r["title"],
                "type": r["type"],
                "score": r["score"],
                "preview": r["preview"],
            } for r in results],
        }, ensure_ascii=False, indent=2))
    else:
        if not results:
            print(f"未命中：{args.query}")
        for i, r in enumerate(results, 1):
            print(f"{i}. [{r['score']:.4f}] {r['path']}  —  {r['title']}")
            if args.preview:
                print(f"     {r['preview'][:200]}")
    return 0 if results else 1


# --------------------------------------------------------------------------
# 状态
# --------------------------------------------------------------------------

def count_content_pages() -> int:
    total = 0
    for path in discover("wiki/"):
        with open(path, encoding="utf-8") as fh:
            ok, _ = is_indexable(path, fh.read())
        if ok:
            total += 1
    return total


def cmd_status(args) -> int:
    index = load_index()
    docs = index.get("docs", {})
    actual = count_content_pages()
    built = index.get("built_at")

    stale = []
    for rel in docs:
        abspath = os.path.join(ROOT, rel)
        if not os.path.exists(abspath):
            stale.append((rel, "文件已删除"))
            continue
        if os.path.getmtime(abspath) > (built or 0) + 1:
            stale.append((rel, "文件已修改"))

    if args.json:
        print(json.dumps({
            "indexed": len(docs),
            "actual_content_pages": actual,
            "behind": max(0, actual - len(docs)),
            "built_at": built,
            "stale_entries": [{"path": p, "reason": r} for p, r in stale],
        }, ensure_ascii=False, indent=2))
        return 0

    print("qmd-lite status")
    print(f"  索引路径         : {os.path.relpath(INDEX_PATH, ROOT)}")
    print(f"  索引文档数       : {len(docs)}")
    print(f"  wiki/ 内容页数   : {actual}  （已排除系统文件与 outputs/ 报告）")
    if built:
        print(f"  上次建索引       : {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(built))}")

    if len(docs) < actual:
        print(f"  ⚠ 索引落后 {actual - len(docs)} 个文件 → 请执行：qmd-lite add wiki/")
    elif stale:
        print(f"  ⚠ {len(stale)} 个索引条目已过期（文件被改动或删除）→ 建议重建索引")
    else:
        print("  ✅ 索引与 wiki/ 一致")

    if stale and not args.quiet:
        for p, r in stale[:10]:
            print(f"      - {p}（{r}）")
    return 0


# --------------------------------------------------------------------------
# 批量读取
# --------------------------------------------------------------------------

def cmd_multi_get(args) -> int:
    paths = []
    for pattern in args.patterns:
        abspath = pattern if os.path.isabs(pattern) else os.path.join(ROOT, pattern)
        matched = sorted(_glob.glob(abspath, recursive=True))
        if not matched and os.path.isfile(abspath):
            matched = [abspath]
        paths.extend(p for p in matched if p.endswith(".md"))

    if not paths:
        print(f"未匹配到文件：{' '.join(args.patterns)}", file=sys.stderr)
        return 1

    total_lines = 0
    for path in paths:
        rel = os.path.relpath(path, ROOT)
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
        shown = lines[:args.limit] if args.limit else lines
        print(f"\n{'=' * 72}\n### {rel}  （共 {len(lines)} 行，显示 {len(shown)} 行）\n{'=' * 72}")
        print("\n".join(shown))
        if args.limit and len(lines) > args.limit:
            print(f"... （已截断，剩余 {len(lines) - args.limit} 行）")
        total_lines += len(shown)

    print(f"\n[multi-get] {len(paths)} 个文件，{total_lines} 行", file=sys.stderr)
    return 0


# --------------------------------------------------------------------------

def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="qmd-lite", description="知识库本地检索（qmd 等价实现）")
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("add", help="建立/更新索引")
    a.add_argument("paths", nargs="*", help="目录或 glob（默认 wiki/）")
    a.add_argument("--prune", action="store_true", help="丢弃不在本次范围内的旧条目")
    a.set_defaults(func=cmd_add)

    q = sub.add_parser("query", help="检索")
    q.add_argument("query")
    q.add_argument("--json", action="store_true")
    q.add_argument("--top-k", type=int, default=5)
    q.add_argument("--preview", action="store_true", help="文本模式下列出摘要")
    q.add_argument("--min-score", type=float, default=0.05,
                   help="相对 top 得分的下限，低于此值不返回（默认 0.05，设 0 关闭）")
    q.set_defaults(func=cmd_query)

    s = sub.add_parser("status", help="索引状态")
    s.add_argument("--json", action="store_true")
    s.add_argument("--quiet", action="store_true")
    s.set_defaults(func=cmd_status)

    m = sub.add_parser("multi-get", help="批量读取")
    m.add_argument("patterns", nargs="+")
    m.add_argument("-l", "--limit", type=int, default=40, help="每个文件显示的行数（0=全部）")
    m.set_defaults(func=cmd_multi_get)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
